algoritmo "Tabuada"

var
   opcao: caractere
   i, j: inteiro

inicio

   escreva("Digite S ou N: ")
   leia(opcao)

   se opcao = "S" entao
      para i de 1 ate 10 faca
         para j de 1 ate 10 faca
            escreval(i, " x ", j, " = ", i * j)
         fimpara
      fimpara
   senao
      escreval("Programa encerrado")
   fimse

fimalgoritmo
